{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MqttClient": "Debug"
    }
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "mqtt-consumer-1",
    "Username": null,
    "Password": null,
    "CleanSession": false,
    "KeepAliveSeconds": 30,
    "SessionExpiryIntervalSeconds": 3600,
    "ReconnectBaseDelaySeconds": 2,
    "ReconnectMaxDelaySeconds": 60,
    "UseTls": false,
    "AllowUntrustedCertificates": false,
    "ClientCertificatePath": null,
    "ClientCertificatePassword": null
  },
  "WorkerPool": {
    "InitialWorkerCount": 4,
    "MaxWorkerCount": 16,
    "MinWorkerCount": 1,
    "ChannelCapacity": 10000,
    "ScaleUpThresholdPercent": 80,
    "ScaleDownThresholdPercent": 20,
    "ScaleCheckIntervalMs": 5000,
    "MaxRetries": 3,
    "ShutdownTimeoutSeconds": 30,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDurationSeconds": 30,
    "BackpressureHighWatermarkPercent": 80
  }
}
